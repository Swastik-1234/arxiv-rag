# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=arxiv_user
POSTGRES_PASSWORD=arxiv_password
POSTGRES_DB=arxiv_db
# Used by the app container directly; docker compose also builds this from
# the POSTGRES_* vars above for the `app` and `airflow` services.
DATABASE_URL=postgresql+asyncpg://arxiv_user:arxiv_password@postgres:5432/arxiv_db

# ── Qdrant ──────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=arxiv_papers

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Groq (LLM) — free key: https://console.groq.com/keys ─
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Jina AI (embeddings) — free key: https://jina.ai/embeddings ─
JINA_API_KEY=jina_your_jina_api_key_here
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# ── Langfuse (self-hosted observability) ───────────────
# Create a project at http://localhost:3000 after `docker compose up -d langfuse`
# then paste the project's keys here and restart the `app` service.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Secrets for the self-hosted Langfuse server itself (any random strings are fine).
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret
LANGFUSE_SALT=change-me-salt-value
LANGFUSE_DB_USER=langfuse_user
LANGFUSE_DB_PASSWORD=langfuse_password
LANGFUSE_DB_NAME=langfuse_db

# ── arXiv ingestion ─────────────────────────────────────
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
ARXIV_MAX_RESULTS=10

# ── Telegram (optional, unused by default) ─────────────
TELEGRAM_BOT_TOKEN=

# ── LangSmith tracing (optional) — free key: https://smith.langchain.com ─
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=arxiv-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Airflow ─────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate with: openssl rand -hex 30
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
